{
    "name": "mckltech/laravel-mighty-networks",
    "description": "A Laravel SDK for the Mighty Networks GraphQL (Mighty API) and Admin REST APIs, built on Saloon.",
    "keywords": [
        "laravel",
        "saloon",
        "mighty-networks",
        "sdk",
        "api",
        "graphql",
        "rest"
    ],
    "homepage": "https://github.com/MCKLtech/laravel-mighty-networks",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.3",
        "illuminate/cache": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/queue": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "saloonphp/cache-plugin": "^3.3",
        "saloonphp/laravel-plugin": "^4.3",
        "saloonphp/pagination-plugin": "^2.0",
        "saloonphp/rate-limit-plugin": "^2.0",
        "saloonphp/saloon": "^4.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "MCKLtech\\MightyNetworks\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MCKLtech\\MightyNetworks\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MCKLtech\\MightyNetworks\\MightyNetworksServiceProvider"
            ],
            "aliases": {
                "MightyNetworks": "MCKLtech\\MightyNetworks\\Facades\\MightyNetworks"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "pint": "vendor/bin/pint",
        "pint:test": "vendor/bin/pint --test",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=1G",
        "check": [
            "@pint:test",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
